# TechLead Hub Web / Docker
TECHLEAD_IMAGE=ghcr.io/taysonrv/techlead-hub:beta
TECHLEAD_PORT=3333

POSTGRES_DB=techlead_hub
POSTGRES_USER=techlead
# Use uma senha forte e exclusiva.
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA

# Gere um segredo longo e aleatório (mínimo recomendado: 32 bytes).
JWT_SECRET=ALTERE_PARA_UM_SEGREDO_FORTE_E_ALEATORIO

# Informe a origem pública quando houver reverse proxy/domínio.
# Ex.: https://techlead.exemplo.com.br
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=loopback

API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000
