{
  "name": "techlead-hub-desktop",
  "version": "0.1.0-beta",
  "description": "TechLead Hub - Support Intelligence",
  "main": "dist/main.js",
  "author": "TechLead Hub",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron": "^39.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.techleadhub.app",
    "productName": "TechLead Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TechLead Hub"
    }
  }
}