generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserRole {
  ADMIN
  COORDENADOR
  ANALISTA
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportStatus {
  PROCESSING
  SUCCESS
  PARTIAL
  ERROR
}

/**
 * =========================================================
 * USUÁRIO
 * =========================================================
 */

model User {
  id Int @id @default(autoincrement())

  // Identificação
  name     String
  username String  @unique
  email    String? @unique

  // Autenticação
  passwordHash String
  role         UserRole @default(ANALISTA)

  // Controle de acesso
  active             Boolean @default(false)
  mustChangePassword Boolean @default(false)

  // Aprovação administrativa
  approvalStatus UserApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   Int?

  // Último acesso
  lastLoginAt DateTime?

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  importRuns          ImportRun[]

  @@index([name])
  @@index([role])
  @@index([active])
  @@index([approvalStatus])
  @@index([approvedById])
}

/**
 * =========================================================
 * RECUPERAÇÃO DE SENHA
 * =========================================================
 */

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

/**
 * =========================================================
 * SESSÕES
 * =========================================================
 */

model UserSession {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  deviceName String?
  userAgent  String?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/**
 * =========================================================
 * EXECUÇÃO DE IMPORTAÇÃO
 * =========================================================
 */

model ImportRun {
  id Int @id @default(autoincrement())

  batch String @unique

  source   String?
  fileName String?

  status ImportStatus @default(PROCESSING)

  totalRows    Int @default(0)
  insertedRows Int @default(0)
  updatedRows  Int @default(0)
  skippedRows  Int @default(0)
  errorRows    Int @default(0)

  message String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([startedAt])
  @@index([finishedAt])
}

/**
 * =========================================================
 * TICKET
 * =========================================================
 */

model Ticket {
  id Int @id @default(autoincrement())

  // Identificação Movidesk
  movideskId Int     @unique
  protocol   String?

  // Atendimento
  subject       String
  category      String?
  cause         String?
  urgency       String?
  status        String
  baseStatus    String?
  justification String?

  // Cliente
  client  String?
  contact String?

  // Responsável
  owner     String?
  ownerTeam String?

  // Produto / Serviço
  service    String?
  department String?

  // Datas
  createdDate DateTime
  dueDate     DateTime?

  firstResponseDueDate DateTime?
  firstResponseDate    DateTime?

  resolvedDate DateTime?
  closedDate   DateTime?

  /**
   * Resultado oficial de SLA importado do Movidesk.
   */
  solutionSlaIndicator String?
  responseSlaIndicator String?

  // Tempos
  lifetimeMinutes Int?
  stoppedMinutes  Int?

  // Desenvolvimento / Task
  taskNumber       Int?
  taskStatus       String?
  deliveredVersion String?

  // Controle da importação
  importSource String?
  importedAt   DateTime?
  importBatch  String?

  importRunId Int?
  importRun   ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([client])
  @@index([contact])
  @@index([owner])
  @@index([ownerTeam])
  @@index([status])
  @@index([baseStatus])
  @@index([category])
  @@index([urgency])

  @@index([createdDate])
  @@index([dueDate])
  @@index([firstResponseDate])
  @@index([resolvedDate])
  @@index([closedDate])

  @@index([solutionSlaIndicator])
  @@index([responseSlaIndicator])

  @@index([taskNumber])
  @@index([taskStatus])

  @@index([importedAt])
  @@index([importBatch])
  @@index([importRunId])
}