# Microsoft Teams Workflows — desativado até homologação
TEAMS_ALERTS_ENABLED=false
# Cole aqui o URL do webhook SOMENTE no .env local (não versionar)
TEAMS_WORKFLOW_WEBHOOK_URL=
# URL-base real da tela de atendimento Movidesk; validar formato antes de ativar
TEAMS_TICKET_BASE_URL=
# Opcional: termos separados por ponto e vírgula
TEAMS_ALERT_TERMS=AGRIQ;receituário;receita
# Opcional: timeout do envio HTTP (1000–30000 ms)
TEAMS_WEBHOOK_TIMEOUT_MS=8000
