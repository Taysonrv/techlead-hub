# Copie para deploy/.env e preencha antes de iniciar.
# PostgreSQL existente, fornecido pela infraestrutura.
TECHLEAD_HUB_IMAGE=ghcr.io/taysonrv/techlead-hub:1.0.0-rc.17
TECHLEAD_HUB_PORT=8080
APP_VERSION=1.0.0-rc.17

# Host acessivel pelo container; codifique caracteres especiais das credenciais na URL.
DATABASE_URL=
JWT_SECRET=
# Mantenha esta chave estavel entre atualizacoes.
SYSTEM_CONFIG_KEY=

CORS_ALLOWED_ORIGINS=https://techlead-hub.aliare.co
PASSWORD_RESET_URL=https://techlead-hub.aliare.co/login
TRUST_PROXY=loopback
MIGRATE_ON_START=true
