# Copie para deploy/.env (nao versionar) e preencha antes de iniciar.
# Exemplo para PostgreSQL EXTERNO gerenciado pela equipe de BD.
# Use a tag publicada e aprovada; nao utilize candidate em producao.
TECHLEAD_HUB_IMAGE=ghcr.io/taysonrv/techlead-hub:beta
TECHLEAD_HUB_PORT=8080

# Endereco acessivel de dentro do container; NAO use localhost para DB externo.
# Substitua os valores. Percent-encode caracteres reservados no usuario e senha.
# Ex.: postgresql://usuario:senha@db.interno:5432/techlead_hub?schema=public
DATABASE_URL=
JWT_SECRET=
# Mantenha esta chave estavel entre atualizacoes (configuracoes criptografadas).
# IMPORTANTE: antes de definir/alterar a chave em um banco existente, valide que
# JWT_SECRET atual consegue ler SystemSetting. A aplicacao preserva leitura
# dos registros legados via JWT_SECRET, sem migrar/regravar automaticamente.
# Nao remova a JWT_SECRET original antes de concluir migracao auditada.
SYSTEM_CONFIG_KEY=

# Ajustar para o endereco real da aplicacao.
CORS_ALLOWED_ORIGINS=
PASSWORD_RESET_URL=
TRUST_PROXY=loopback
AZURE_SYNC_SCHEDULER_ENABLED=true
# Em banco gerenciado, migrations devem ser aprovadas pela equipe de BD.
MIGRATE_ON_START=false
SESSION_IDLE_TIMEOUT_MS=300000
